generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  projects     Project[]
  accounts     Account[]
  sessions     Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id        String         @id @default(cuid())
  name      String
  createdAt DateTime       @default(now())
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id])
  tradePkgs TradePackage[]
}

model TradePackage {
  id           String                @id @default(cuid())
  projectId    String
  name         String
  csiDivision  String?
  project      Project               @relation(fields: [projectId], references: [id])
  bidders      Bidder[]
  normalizedItems NormalizedScopeItem[]
  riskAssessments RiskAssessment[]
}

model Bidder {
  id             String        @id @default(cuid())
  tradePackageId String
  companyName    String
  contactEmail   String?
  tradePackage   TradePackage  @relation(fields: [tradePackageId], references: [id])
  documents      BidDocument[]
  riskAssessments RiskAssessment[]
  normalizedBidItems NormalizedBidItem[]
}

model BidDocument {
  id            String   @id @default(cuid())
  bidderId      String
  filename      String
  mimeType      String
  filePath      String
  uploadedAt    DateTime @default(now())
  status        BidStatus @default(UPLOADED)
  extractedText String?
  extractionMeta Json?
  bidder        Bidder    @relation(fields: [bidderId], references: [id])
  parses        BidParse[]
}

enum BidStatus {
  UPLOADED
  EXTRACTED
  PARSED
  FAILED
}

model BidParse {
  id           String   @id @default(cuid())
  bidDocumentId String
  parsedJson   Json
  parseVersion Int
  createdAt    DateTime @default(now())
  bidDocument  BidDocument @relation(fields: [bidDocumentId], references: [id])
}

model NormalizedScopeItem {
  id          String   @id @default(cuid())
  tradePackageId String
  scopeKey    String
  scopeLabel  String
  category    ScopeCategory @default(OTHER)
  tradePackage TradePackage @relation(fields: [tradePackageId], references: [id])
  bids        NormalizedBidItem[]
}

enum ScopeCategory {
  MATERIAL
  LABOR
  EXCLUSION
  ASSUMPTION
  ALTERNATE
  OTHER
}

model NormalizedBidItem {
  id                   String   @id @default(cuid())
  normalizedScopeItemId String
  bidderId             String
  value                String
  confidence           Float
  sourceRefs           Json?
  bidder               Bidder   @relation(fields: [bidderId], references: [id])
  normalizedScopeItem  NormalizedScopeItem @relation(fields: [normalizedScopeItemId], references: [id])
}

model RiskAssessment {
  id             String   @id @default(cuid())
  bidderId       String
  tradePackageId String
  riskScore      Int
  reasons        Json
  createdAt      DateTime @default(now())
  bidder         Bidder   @relation(fields: [bidderId], references: [id])
  tradePackage   TradePackage @relation(fields: [tradePackageId], references: [id])
}
