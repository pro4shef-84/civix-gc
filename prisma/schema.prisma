// Prisma schema modeling the preconstruction bid-leveling domain.
// See README for entity descriptions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  estimator
  viewer
}

enum InvitationStatus {
  invited
  interested
  no_bid
  submitted
  needs_clarification
}

enum BidSourceType {
  pdf
  email
  csv
}

enum ParseStatus {
  pending
  processing
  parsed
  failed
}

enum LevelingStatus {
  draft
  in_progress
  ready
  archived
}

model Org {
  id          String   @id @default(cuid())
  name        String
  billingPlan String?
  users       User[]
  projects    Project[]
  subcontractors Subcontractor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id        String   @id @default(cuid())
  org       Org      @relation(fields: [orgId], references: [id])
  orgId     String
  name      String
  email     String   @unique
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projects  Project[] @relation("ProjectCreators")
}

model Project {
  id         String      @id @default(cuid())
  org        Org         @relation(fields: [orgId], references: [id])
  orgId      String
  name       String
  bidDueAt   DateTime
  createdBy  User?       @relation("ProjectCreators", fields: [createdById], references: [id])
  createdById String?
  tradeScopes TradeScope[]
  events      EventLog[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model TradeScope {
  id           String         @id @default(cuid())
  project      Project        @relation(fields: [projectId], references: [id])
  projectId    String
  name         String
  csiDivision  String?
  bidDocuments BidDocument[]
  invitations  Invitation[]
  parsedLines  ParsedLine[]
  levelingSheet LevelingSheet?
  rfis         RFI[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Subcontractor {
  id      String   @id @default(cuid())
  org     Org      @relation(fields: [orgId], references: [id])
  orgId   String
  name    String
  email   String?
  phone   String?
  trades  String[]
  invitations Invitation[]
  bidDocuments BidDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id               String            @id @default(cuid())
  tradeScope       TradeScope        @relation(fields: [tradeScopeId], references: [id])
  tradeScopeId     String
  subcontractor    Subcontractor     @relation(fields: [subcontractorId], references: [id])
  subcontractorId  String
  status           InvitationStatus
  lastContactedAt  DateTime?
  dueAt            DateTime?
  total            Decimal? @db.Decimal(18, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  bidDocuments     BidDocument[]
}

model BidDocument {
  id              String         @id @default(cuid())
  tradeScope      TradeScope     @relation(fields: [tradeScopeId], references: [id])
  tradeScopeId    String
  subcontractor   Subcontractor  @relation(fields: [subcontractorId], references: [id])
  subcontractorId String
  invitation      Invitation?    @relation(fields: [invitationId], references: [id])
  invitationId    String?
  srcType         BidSourceType
  storageUri      String
  uploadedBy      String
  parsedStatus    ParseStatus     @default(pending)
  uploadedAt      DateTime        @default(now())
  parsedLines     ParsedLine[]
}

model ParsedLine {
  id             String        @id @default(cuid())
  bidDocument    BidDocument   @relation(fields: [bidDocumentId], references: [id])
  bidDocumentId  String
  description    String?
  qty            Float?
  unit           String?
  price          Decimal?      @db.Decimal(18, 2)
  notes          String?
  confidence     Float?
  csiCode        String?
  normalizedKey  String?
  category       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model LevelingSheet {
  id             String        @id @default(cuid())
  tradeScope     TradeScope    @relation(fields: [tradeScopeId], references: [id])
  tradeScopeId   String        @unique
  status         LevelingStatus @default(draft)
  snapshotUri    String?
  gaps           Int            @default(0)
  overlaps       Int            @default(0)
  parsedCoverage Float?         @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model RFI {
  id            String       @id @default(cuid())
  tradeScope    TradeScope   @relation(fields: [tradeScopeId], references: [id])
  tradeScopeId  String
  question      String
  toSubIds      String[]
  status        String       @default("open")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model EventLog {
  id        String   @id @default(cuid())
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
  type      String
  payload   Json
  createdAt DateTime @default(now())
}
